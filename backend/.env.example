PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ghardaari?schema=public"
JWT_SECRET="replace_this_with_a_long_random_secret"
ADMIN_EMAILS="admin@example.com"
ALLOWED_ORIGINS="http://127.0.0.1:5500,http://localhost:5500"
RATE_LIMIT_STORE="memory"

# Frontend/backend public URLs used in emails and upload URLs
FRONTEND_URL="http://127.0.0.1:5500"
PUBLIC_BACKEND_URL="http://127.0.0.1:5000"

# Real email sending
# Use EMAIL_PROVIDER="console" locally. Use EMAIL_PROVIDER="resend" in production.
EMAIL_PROVIDER="console"
EMAIL_FROM="GharDaari <onboarding@resend.dev>"
RESEND_API_KEY=""

# Cloud image storage
# Use STORAGE_DRIVER="local" locally. Use STORAGE_DRIVER="supabase" in production.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ghardaari-uploads"
SUPABASE_STORAGE_PUBLIC_URL=""
