generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  THOUGHT
  QUESTION
  EXPERIENCE
  ADVICE
}

enum ResourceType {
  YOUTUBE_VIDEO
  ARTICLE
  GUIDE
  WEBSITE
  PDF
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  GROUP_MESSAGE
  DIRECT_MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

model User {
  id                         Int      @id @default(autoincrement())
  fullName                   String
  username                   String   @unique
  email                      String   @unique
  passwordHash               String
  role                       UserRole @default(MEMBER)
  bio                        String?
  profileImage               String?
  emailVerified              Boolean  @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  securityMotherNameHash     String?
  securityBirthMonthHash     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  posts                       Post[]
  comments                    Comment[]
  postLikes                   PostLike[]
  savedPosts                  SavedPost[]
  createdGroups               Group[]                      @relation("CreatedGroups")
  groupMemberships            GroupMember[]
  groupMessages               GroupMessage[]
  directConversationMembers   DirectConversationMember[]
  directMessages              DirectMessage[]
  resources                   Resource[]
  reportsSubmitted            Report[]                     @relation("ReportsSubmitted")
  reportsModerated            Report[]                     @relation("ReportsModerated")
  blockedUsers                BlockedUser[]                @relation("BlockedUsers")
  blockedByUsers              BlockedUser[]                @relation("BlockedByUsers")
  warningsReceived            UserWarning[]                @relation("WarningsReceived")
  warningsIssued              UserWarning[]                @relation("WarningsIssued")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  icon        String?
  createdAt   DateTime @default(now())

  posts     Post[]
  resources Resource[]
}

model Post {
  id          Int      @id @default(autoincrement())
  userId      Int
  categoryId  Int
  text        String
  imageUrl    String?
  type        PostType @default(THOUGHT)
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id])
  comments  Comment[]
  likes     PostLike[]
  savedBy   SavedPost[]

  @@index([userId])
  @@index([categoryId])
}

model Comment {
  id          Int      @id @default(autoincrement())
  postId      Int
  userId      Int
  commentText String
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Resource {
  id           Int          @id @default(autoincrement())
  categoryId   Int
  userId       Int?
  title        String
  type         ResourceType
  sourceName   String
  description  String
  url          String
  thumbnailUrl String?
  createdAt    DateTime     @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([userId])
}

model Group {
  id          Int      @id @default(autoincrement())
  createdById Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User           @relation("CreatedGroups", fields: [createdById], references: [id])
  members   GroupMember[]
  messages  GroupMessage[]

  @@index([createdById])
}

model GroupMember {
  id       Int       @id @default(autoincrement())
  groupId  Int
  userId   Int
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id          Int      @id @default(autoincrement())
  groupId     Int
  senderId    Int
  messageText String
  imageUrl    String?
  createdAt   DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([senderId])
}

model DirectConversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  members  DirectConversationMember[]
  messages DirectMessage[]
}

model DirectConversationMember {
  id             Int @id @default(autoincrement())
  conversationId Int
  userId         Int

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  messageText    String
  imageUrl       String?
  createdAt      DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Report {
  id            Int              @id @default(autoincrement())
  reporterId    Int
  moderatorId   Int?
  targetType    ReportTargetType
  targetId      Int
  reason        String
  status        ReportStatus     @default(PENDING)
  moderatorNote String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  reporter  User  @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User? @relation("ReportsModerated", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([moderatorId])
  @@index([status])
  @@index([targetType, targetId])
}

model UserWarning {
  id          Int      @id @default(autoincrement())
  userId      Int
  moderatorId Int?
  message     String
  createdAt   DateTime @default(now())

  user      User  @relation("WarningsReceived", fields: [userId], references: [id], onDelete: Cascade)
  moderator User? @relation("WarningsIssued", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([moderatorId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
